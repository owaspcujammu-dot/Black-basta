# Black Basta — environment configuration
# Copy to .env and fill in real values:   cp .env.example .env
# Never commit .env. Never put real secrets in this file.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used when the backend runs on your machine).
# With `docker compose up`, the backend container builds its own URL from
# POSTGRES_PASSWORD below and ignores this value.
# This PC has no PostgreSQL server, so `npm run dev` uses the same built-in
# database as `npm run demo` (only one of them can run at a time).
DATABASE_URL="" 				# Provide a value for DATABASE_URL
# To use a real PostgreSQL instead (e.g. `docker compose up -d postgres`), switch to:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/king_of_pirates

# Password of the PostgreSQL container created by docker compose.
POSTGRES_PASSWORD="" 				# Provide a value for POSTGRES_PASSWORD

# ── Secrets (REQUIRED — the server refuses to start in production without them)
# Signs session tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="" 				# Provide a value for JWT_SECRET

# Optional: encrypts the admin-viewable copies of flags and team passwords
# (default: JWT_SECRET). Set it if you might rotate JWT_SECRET later.
ADMIN_SECRETS_KEY=""

# Admin account, created/updated by the seed. There is no default password:
# while this is CHANGE_ME (or empty) no admin account is created.
ADMIN_USERNAME="" 				# Provide a value for ADMIN_USERNAME
ADMIN_PASSWORD="" 				# Provide a value for ADMIN_PASSWORD
ADMIN_EMAIL="" 				# Provide a value for ADMIN_EMAIL

# ── Server ──────────────────────────────────────────────────────────────────
PORT="" 				# Provide a value for PORT

# Public URL(s) of the website, comma-separated. Used for CORS and CSRF origin
# checks. In production this is your https:// domain.
FRONTEND_URL="" 				# Provide a value for FRONTEND_URL

# Send the session cookie over HTTPS only. Set to true once HTTPS is in place.
# (Defaults to true when NODE_ENV=production; docker compose defaults it to false.)
COOKIE_SECURE="" 				# Provide a value for COOKIE_SECURE

# Number of reverse proxies in front of the backend, so client IPs are read
# correctly for rate limiting. 0 = none (direct). Docker compose sets this itself.
TRUST_PROXY="" 				# Provide a value for TRUST_PROXY

# ── Event ───────────────────────────────────────────────────────────────────
EVENT_NAME="" 				# Provide a value for EVENT_NAME
MAX_PARTICIPANTS="" 				# Provide a value for MAX_PARTICIPANTS
FLAG_PREFIX="" 				# Provide a value for FLAG_PREFIX

# Bonus points for the first pirate to solve each challenge (0 = badge only).
FIRST_BLOOD_BONUS="" 				# Provide a value for FIRST_BLOOD_BONUS

# Optional schedule used when the event row is first created (ISO-8601).
# Both can be changed later in the admin panel.
# EVENT_START_AT=2026-11-01T09:00:00+05:30
# EVENT_END_AT=2026-11-01T17:00:00+05:30

# ── Teams ───────────────────────────────────────────────────────────────────
# false = organizers create team accounts (Admin → Pirates → Add teams) and
# players log in with team name + password; the sign-up page is closed.
SELF_REGISTRATION="" 				# Provide a value for SELF_REGISTRATION
# Players per team: the most member names a team can list, and the most
# devices that can be logged in to one team at the same time.
MAX_TEAM_SIZE="" 				# Provide a value for MAX_TEAM_SIZE

# ── Sample data ─────────────────────────────────────────────────────────────
# The platform starts EMPTY: no challenges, no announcements, no sample pirates.
# Set to true to seed eight SAMPLE challenges (their flags are public, in the
# source code) when the challenge table is empty. Leave false for a real event.
SEED_DEMO_CHALLENGES="" 				# Provide a value for SEED_DEMO_CHALLENGES

# Demo mode: embedded database + an admin and a `demo` participant login, for
# testing the whole platform locally (`npm run demo`). The server REFUSES to start
# with DEMO_MODE=true when NODE_ENV=production.
DEMO_MODE="" 				# Provide a value for DEMO_MODE

# Password of the `demo` participant created by demo mode (npm run demo).
DEMO_PASSWORD="" 				# Provide a value for DEMO_PASSWORD

# ── Limits ──────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED="" 				# Provide a value for RATE_LIMIT_ENABLED
# Flag submissions allowed per participant per minute (all challenges / one challenge).
SUBMIT_LIMIT_PER_MIN="" 				# Provide a value for SUBMIT_LIMIT_PER_MIN
SUBMIT_LIMIT_PER_CHALLENGE="" 				# Provide a value for SUBMIT_LIMIT_PER_CHALLENGE

# bcrypt cost factor for password hashes.
BCRYPT_ROUNDS="" 				# Provide a value for BCRYPT_ROUNDS
# Session lifetime in hours.
SESSION_HOURS="" 				# Provide a value for SESSION_HOURS
# PostgreSQL connection pool size.
DB_POOL_MAX="" 				# Provide a value for DB_POOL_MAX

# ── Uploads ─────────────────────────────────────────────────────────────────
# Where challenge attachments are stored (relative to the repository root, or absolute).
UPLOAD_DIR="" 				# Provide a value for UPLOAD_DIR
MAX_UPLOAD_MB="" 				# Provide a value for MAX_UPLOAD_MB

# ── Development only ────────────────────────────────────────────────────────
# Where the Vite dev server forwards /api (change if PORT is not 5000).
# VITE_API_PROXY=http://localhost:5000

# Docker: publish the site on all network interfaces so other devices can open it
# (127.0.0.1 = this PC only).
BIND_ADDRESS="" 				# Provide a value for BIND_ADDRESS

# ── Automatic backups (docker compose service "backup") ──────────────────────
# A full copy every N minutes into BACKUP_DIR; the newest BACKUP_KEEP are kept.
BACKUP_INTERVAL_MINUTES=15
BACKUP_KEEP=200
BACKUP_DIR=./backups
BACKUP_TIMEZONE=Asia/Kolkata
